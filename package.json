{
  "type": "module",
  "scripts": {
    "postinstall": "dotnet tool restore",
    "build": "dotnet fable src --sourceMaps",
    "watch": "dotnet fable watch src --sourceMaps",
    "demo": "dotnet fable watch demo --sourceMaps --run vite demo",
    "build:demo": "dotnet fable demo --sourceMaps && vite build demo",
    "test": "dotnet fable tests/Mibo.Fable.Tests.fsproj --noCache --sourceMaps && qunit \"tests/*Tests.fs.js\""
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "qunit": "^2.26.0",
    "vite": "8.2.2"
  },
  "dependencies": {
    "@preact/signals-core": "^1.14.4"
  }
}
